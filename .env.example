# Family password (required for the gated app)
CHIMES_SITE_PASSWORD=

# Optional dedicated session HMAC secret (16+ chars). Derived from the site password if omitted.
# CHIMES_SESSION_SECRET=

# Guy-only request inbox at /inbox (NOT linked from Dad UI). Second secret —
# Dad’s family login is not enough. Set on Vercel for production.
GUY_INBOX_PASSWORD=
# Optional dedicated HMAC for the inbox cookie (16+ chars). Derived from GUY_INBOX_PASSWORD if omitted.
# GUY_INBOX_SESSION_SECRET=

# Bearer token for Dad’s house MCP:
#   Streamable HTTP tools at /api/mcp — submit_bug + submit_feature
#   REST fallback POST /api/requests with { kind: "bug"|"feature", ... }
# Same store as the /bug and /feature web forms. Not the inbox password.
CHIMES_REQUEST_API_TOKEN=

# Postgres (Neon) for durable request + image storage on Vercel.
# Local/preview without this uses in-memory PGLite (fine for demos; resets on restart).
# DATABASE_URL=

# Home Assistant — server live mode (token never sent to the browser)
HA_URL=https://chimes-pi.tail8e29b8.ts.net
HA_TOKEN=
